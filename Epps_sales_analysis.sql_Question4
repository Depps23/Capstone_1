SELECT YEAR(Date) AS Sales_Year, MONTH(Date) AS Sales_Month, COUNT(*) AS Transaction_Count, ROUND(AVG(SalesTotal), 2) AS Average_Sale_Amount
FROM online_sales
WHERE ShiptoState LIKE 'Maryland%'
    OR ShiptoState LIKE 'Massachusetts%'
		  OR ShiptoState LIKE 'Maine%'
			  OR ShiptoState LIKE 'New Jersey%'
GROUP BY YEAR(Date), MONTH(Date)
ORDER BY Sales_Year,Sales_Month;
